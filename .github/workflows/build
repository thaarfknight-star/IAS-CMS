name: Build Desktop EXE

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: "3.10"

    - name: Install CMake
      run: |
        choco install cmake --installargs "ADD_CMAKE_TO_PATH=System"

    - name: Install Dependencies
      run: |
        python -m pip install --upgrade pip setuptools wheel
        pip install dlib --only-binary :all: || pip install dlib
        pip install -r requirements.txt

    - name: Build Executable with PyInstaller
      run: |
        pyinstaller --noconfirm --onedir --windowed --name "CCTV_CMS" --add-data "faces;faces" --hidden-import "face_recognition_models" --hidden-import "PyQt6" main.py

    - name: Upload Build Artifact
      uses: actions/upload-artifact@v4
      with:
        name: CCTV_CMS_Windows
        path: dist/CCTV_CMS/
