# فایل‌های حاوی اطلاعات حساس (IP/نام‌کاربری/رمز عبور دوربین‌ها و NVR) که موقع
# اجرای برنامه ساخته می‌شوند - نباید روی گیت‌هاب (حتی خصوصی) قرار بگیرند.
cameras.json
nvrs.json
face_db.json

# عکس‌های ثبت‌شده‌ی افراد در Face Library
faces/*.jpg
faces/*.png
!faces/.gitkeep

# فایل‌های پایتون
__pycache__/
*.pyc
*.pyo

# خروجی build
build/
dist/
*.spec

# محیط مجازی (در صورت استفاده)
venv/
.venv/

# فایل‌های مدل تشخیص شخص (PersonDetector) - در اولین اجرا خودکار دانلود
# می‌شوند (رجوع کنید به person_detector.py)، نیازی به قرارگرفتن روی گیت‌هاب
# نیست (حجیم هستند: چند ده مگابایت).
models/
